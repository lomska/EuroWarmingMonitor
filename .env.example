# Copy this file to .env and replace every value. .env is never committed.

# Superuser (admin only, not used by the pipeline)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_DB=climate
POSTGRES_PORT=5432          # use 5433 if a local PostgreSQL already uses 5432

# Project roles
LOADER_PASSWORD=change-me-loader
TRANSFORMER_PASSWORD=change-me-transformer
READER_PASSWORD=change-me-reader

# App: where it reads from. postgres = the marts (as reader); parquet = files made
# by "python pipeline.py export": a folder, or the https:// address they are published
# at (export/publish_release.py), downloaded when the app starts, e.g.
#   https://github.com/<owner>/<repo>/releases/latest/download
TEMPRADAR_SOURCE=postgres
TEMPRADAR_PARQUET=data/app
